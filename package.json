{
  "name": "@stairno/ui",
  "version": "0.2.2",
  "description": "Shared design tokens and components for every Stairno site",
  "repository": "github:seren-wib/stairno-ui",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/lib/theme.ts",
    "./i18n": "./src/lib/i18n.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "astro": "^7.4.0",
    "happy-dom": "^20.14.5",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
