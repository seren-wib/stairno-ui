---
import type { Locale } from '../lib/i18n';
import { accountInitial, type AccountUser } from '../lib/account';

export type { AccountUser };

export interface AccountMenuLabels {
  /** aria-label of the button while someone is signed in. */
  signedIn: string;
  /** aria-label of the button while no one is signed in. */
  signedOut: string;
  /** Link to the account center overview. */
  manage: string;
  signOut: string;
  signIn: string;
  signUp: string;
}

interface Props {
  locale: Locale;
  labels: AccountMenuLabels;
  /** Account center overview. */
  accountUrl: string;
  signInUrl: string;
  signUpUrl: string;
  /** POSTed with credentials on log out; the page reloads afterwards. */
  signOutUrl: string;
  /** The signed-in user, when the server knows it. Wins over `sessionUrl`. */
  user?: AccountUser | null;
  /** Read in the browser when the server does not know the user (the hub). */
  sessionUrl?: string;
  /** Id of the card. Defaults to a generated one. */
  id?: string;
}

const {
  locale,
  labels,
  accountUrl,
  signInUrl,
  signUpUrl,
  signOutUrl,
  user = null,
  sessionUrl,
  id = `account-menu-${crypto.randomUUID().slice(0, 8)}`,
} = Astro.props;

const signedIn = user !== null;
const readsSession = !signedIn && Boolean(sessionUrl);
const initial = accountInitial(user, locale);
const displayName = user ? user.name.trim() || user.email : '';
const hasName = Boolean(user?.name.trim());
---

<div
  class="user-menu"
  data-account-menu
  data-state={signedIn ? 'signed-in' : 'signed-out'}
  data-locale={locale}
  data-sign-out-url={signOutUrl}
  data-session-url={readsSession ? sessionUrl : undefined}
  data-label-signed-in={labels.signedIn}
  data-label-signed-out={labels.signedOut}
>
  <button
    type="button"
    class="user-menu-button"
    data-account-button
    aria-expanded="false"
    aria-controls={id}
    aria-label={signedIn ? labels.signedIn : labels.signedOut}
  >
    <span class="user-menu-initial" data-account-initial hidden={!signedIn}>
      {initial}
    </span>
    <span class="user-menu-icon" data-account-icon hidden={signedIn}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path
          d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </span>
  </button>
  <div class="user-menu-card" id={id} data-account-card hidden>
    {(signedIn || readsSession) && (
      <div class="user-menu-section" data-account-signed-in hidden={!signedIn}>
        <div class="user-menu-who">
          <p class="user-menu-name" data-account-name>
            {displayName}
          </p>
          <p class="user-menu-email" data-account-email hidden={signedIn && !hasName}>
            {user?.email}
          </p>
        </div>
        <a class="user-menu-row" href={accountUrl}>
          {labels.manage}
        </a>
        <button type="button" class="user-menu-row" data-account-sign-out>
          {labels.signOut}
        </button>
      </div>
    )}
    {!signedIn && (
      <div class="user-menu-section user-menu-actions" data-account-signed-out>
        <a class="user-menu-primary" href={signInUrl}>
          {labels.signIn}
        </a>
        <a class="user-menu-secondary" href={signUpUrl}>
          {labels.signUp}
        </a>
      </div>
    )}
  </div>
</div>

<script>
  import { mountAccountMenu } from '../lib/account';

  for (const root of document.querySelectorAll<HTMLElement>('[data-account-menu]')) {
    void mountAccountMenu(root);
  }
</script>

<style>
  /* Class rules below set display; this keeps the hidden attribute in charge. */
  [hidden] {
    display: none !important;
  }

  .user-menu {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
  }

  .user-menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--on-night-faint);
    border-radius: 999px;
    background: var(--on-night-faint);
    color: var(--on-night);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .user-menu-button:hover,
  .user-menu-button[aria-expanded='true'] {
    border-color: var(--on-night-muted);
  }

  .user-menu-initial,
  .user-menu-icon {
    display: inline-flex;
  }

  .user-menu-card {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: calc((44px - 36px) / 2);
    z-index: 20;
    width: 280px;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.6);
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.35);
    font-size: 0.9375rem;
    line-height: 1.4;
    text-align: left;
    animation: user-menu-in 120ms ease-out both;
  }

  @keyframes user-menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .user-menu-section {
    display: grid;
    gap: 0.125rem;
  }

  .user-menu-who {
    display: grid;
    gap: 0.125rem;
    padding: 0.625rem 0.75rem 0.875rem;
    margin-bottom: 0.375rem;
    border-bottom: 1px solid var(--border);
  }

  .user-menu-name {
    font-weight: 700;
  }

  .user-menu-email {
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .user-menu-row {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .user-menu-row:hover {
    background: var(--surface);
  }

  .user-menu-row:disabled {
    color: var(--fg-muted);
    cursor: progress;
  }

  .user-menu-actions {
    gap: 0.5rem;
    padding: 0.25rem;
  }

  .user-menu-primary,
  .user-menu-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--fg);
    border-radius: 999px;
    font-weight: 700;
  }

  .user-menu-primary {
    background: var(--fg);
    color: var(--bg);
  }

  .user-menu-secondary {
    background: transparent;
    color: var(--fg);
  }

  .user-menu-secondary:hover {
    background: var(--surface);
  }

  /* Narrow screens: the button is not at the edge, so pin the card to the gutters instead. */
  @media (max-width: 480px) {
    .user-menu {
      position: static;
    }
    .user-menu-card {
      position: fixed;
      top: calc(var(--header-height) - 0.25rem);
      right: var(--gutter);
      width: auto;
      max-width: 280px;
      left: max(var(--gutter), calc(100vw - var(--gutter) - 280px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .user-menu-button {
      transition: none;
    }
    .user-menu-card {
      animation: none;
    }
  }
</style>
