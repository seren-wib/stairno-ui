---
export interface ThemeLabels {
  /** aria-label once the page is dark: what the next click does. */
  light: string;
  /** aria-label once the page is light: what the next click does. */
  dark: string;
  /** aria-label before the script has run. */
  toggle: string;
}

interface Props {
  labels: ThemeLabels;
}

const { labels } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label={labels.toggle}
  data-label-light={labels.light}
  data-label-dark={labels.dark}
>
  <svg class="icon icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path
      d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    ></path>
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path
      d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
    ></path>
  </svg>
</button>

<script>
  import { THEME_KEY, isTheme, nextTheme, resolveTheme, type Theme } from '../lib/theme';

  const root = document.documentElement;

  function currentTheme(): Theme {
    const applied = root.dataset.theme;
    if (isTheme(applied)) return applied;
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(THEME_KEY);
    } catch {
      // storage can be unavailable; fall through to the system preference
    }
    return resolveTheme(stored, matchMedia('(prefers-color-scheme: dark)').matches);
  }

  function apply(theme: Theme, buttons: HTMLButtonElement[]): void {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    const next = nextTheme(theme);
    for (const button of buttons) {
      const label = button.dataset[`label${next[0].toUpperCase()}${next.slice(1)}`];
      if (label) button.setAttribute('aria-label', label);
    }
  }

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));
  apply(currentTheme(), buttons);

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const next = nextTheme(currentTheme());
      try {
        localStorage.setItem(THEME_KEY, next);
      } catch {
        // storage can be unavailable; the choice still applies for this page
      }
      apply(next, buttons);
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--on-night-faint, rgba(255, 255, 255, 0.12));
  }
  .icon-moon {
    display: none;
  }
  :global(html[data-theme='dark']) .icon-sun {
    display: none;
  }
  :global(html[data-theme='dark']) .icon-moon {
    display: block;
  }
</style>
